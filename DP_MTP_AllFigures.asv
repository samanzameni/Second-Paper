%% ============================================================
%  TABLE 7:
%  Varying Pmax
%% ============================================================


fprintf('--- Table 7: Varying Pmax ---\n');


fprintf( ...
'%-10s | %-14s | %-14s | %-14s\n', ...
'Pmax (dBm)', ...
'Sensitivity', ...
'MAE (dBm)', ...
'Efficiency (%)');


fprintf('%s\n',repmat('-',1,58));


Pmax_vals = [20,25,30,35,40];


for pIdx = 1:length(Pmax_vals)

    Pm = Pmax_vals(pIdx);

    Delta_f_pm = ...
    Pm / P_max * Delta_f;

    [mae_pm,eta_pm,~, ~, ~] = ...
    run_mc( ...
    1.0, ...
    Delta_f_pm, ...
    N_SU, ...
    N_PU, ...
    Pm, ...
    area_size, ...
    100, ...
    gamma, ...
    sigma_m);


    eta_pm_cal = ...
    eta_pm * scale_eta * 100;


    fprintf( ...
    '%-10d | %-14.4f | %-14.4f | %-14.2f\n', ...
    Pm, ...
    Delta_f_pm, ...
    mae_pm, ...
    eta_pm_cal);


end


fprintf('\n');



%% ============================================================
%  TABLE 8:
%  Varying Path-Loss Scaling Factor gamma
%% ============================================================
fprintf('--- Table 8: Varying Path-Loss Scaling Factor gamma ---\n');
fprintf( ...
'%-10s | %-14s | %-14s\n', ...
'gamma', ...
'Simulated MAE', ...
'Attack RMSE (m)');
fprintf('%s\n',repmat('-',1,42));
gamma_vals = [50,100,120,150,200];
for gi = 1:length(gamma_vals)
    gv = gamma_vals(gi);
    Delta_f_gv = P_max / gv;
    [mae_gv,~,rmse_gv, ~, ~] = ...
    run_mc( ...
    1.0, ...
    Delta_f_gv, ...
    N_SU, ...
    N_PU, ...
    P_max, ...
    area_size, ...
    num_runs, ...
    gv, ...
    sigma_m);
    fprintf( ...
'%-10d | %-14.4f | %-14.2f\n', ...
    gv, ...
    mae_gv, ...
    rmse_gv);
end

fprintf('\n');


