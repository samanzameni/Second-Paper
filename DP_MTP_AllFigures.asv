%% =============================================================
%  MASTER SCRIPT: All 7 Figures and 8 Tables— DP-MTP Paper
%
%  UPDATED PROPAGATION / MEASUREMENT MODEL:
%
%  P_true = P_max * exp(-d/gamma)
%
%  P_obs = clip(P_true + N(0,sigma_m^2))
%
%  P_DP  = clip(P_obs + Lap(0,Delta_f/epsilon))
%
%  Monte Carlo runs = 1000
%  rng = 42
%% =============================================================

clc;
clear;
close all;

rng(42);


%% ============================================================
%  GLOBAL PARAMETERS 
%% ============================================================

epsilon_vals  = [0.1, 0.5, 1.0, 1.5, 2.0, 5.0, 10.0];      

N_SU          = 100;       % Secondary Users
N_PU          = 10;        % Primary Users

P_max         = 30;        % Maximum transmit power (dBm)

area_size     = 1000;      % meters

num_runs      = 1000;      % Monte Carlo runs

epsilon_base  = 1.0;       % Adaptive DP base epsilon
alpha_adapt   = 0.5;
beta_adapt    = 2.0;

gamma         = 120;        % Path-loss scaling parameter
Delta_f       = P_max / gamma; % DP sensitivity (dBm/m)
% =============================================================
% NEW PARAMETER
% Measurement noise standard deviation
% =============================================================

sigma_m       = 0.5;       % dBm

scale_eta     = 1.0;


fprintf('========================================\n');
fprintf('=== DP-MTP Paper: All Figures ===\n');
fprintf('========================================\n');

fprintf('Parameters loaded from Section 6.1\n');

fprintf('Measurement noise sigma_m = %.2f dBm\n\n', sigma_m);



%% ============================================================
%  PRE-COMPUTE:
%  MAE, eta, RMSE for all epsilon values
%% ============================================================


MAE_theoretical = Delta_f ./ epsilon_vals;


fprintf('Running main Monte Carlo simulations...\n');


[MAE_simulated, ...
 eta_simulated, ...
 RMSE_DPMTP_m, ...
 all_errors, ...
 MAE_total_dpmtp] = ...
 run_mc( ...
 epsilon_vals, ...
 Delta_f, ...
 N_SU, ...
 N_PU, ...
 P_max, ...
 area_size, ...
 num_runs, ...
 gamma, ...
 sigma_m);


eta_cal = eta_simulated * 100;


idx1 = find(epsilon_vals == 1.0);

mae_dpmtp_total = MAE_total_dpmtp(idx1);

%% ============================================================
%  BASELINE SIMULATIONS
%% ============================================================


fprintf('Running baseline simulations...\n');


[rmse_lo_m, ...
 rmse_kanon_m, ...
 rmse_cr_m, ...
 rmse_base_m, ...
 mae_lo, ...
 mae_kanon, ...
 mae_cr, ...
 mae_base, ...
 eta_lo_raw, ...
 eta_kanon_raw, ...
 eta_cr_raw] = ...
 run_baselines( ...
 N_SU, ...
 N_PU, ...
 P_max, ...
 area_size, ...
 num_runs, ...
 gamma, ...
 Delta_f, ...
 sigma_m);



eta_lo    = eta_lo_raw * 100;

eta_kanon = eta_kanon_raw * 100;

eta_cr    = eta_cr_raw * 100;



RMSE_base_val = rmse_base_m;


RMSE_LO = rmse_lo_m * ones(1,length(epsilon_vals));

RMSE_KAnon = rmse_kanon_m * ones(1,length(epsilon_vals));

RMSE_CR = rmse_cr_m * ones(1,length(epsilon_vals));

RMSE_base = RMSE_base_val * ones(1,length(epsilon_vals));



%% ============================================================
%  NO DP BASELINE
%
% epsilon = infinity
%
% In this case:
%
% P_DP = P_obs
%
% But measurement noise still exists.
%% ============================================================


[~, eta_no_noise_sim, ~, ~, ~] = ...
run_mc( ...
inf, ...
Delta_f, ...
N_SU, ...
N_PU, ...
P_max, ...
area_size, ...
num_runs, ...
gamma, ...
sigma_m);


eta_no_noise = eta_no_noise_sim * 100;



fprintf('Actual simulated eta at eps=1: %.2f%%\n\n', ...
eta_cal(idx1));

%% ============================================================
%  FIGURE 1:
%  Empirical CDF of DP Power Error (from simulation)
%% ============================================================

figure( ...
'Units','inches', ...
'Position',[0.5 0.5 5.2 4.0], ...
'Name','CDF Power Error');

eps_cdf = [0.1, 0.5, 1.0, 2.0, 5.0, 10.0];

colors_cdf = { ...
[0.635 0.078 0.184], ...
[0.850 0.325 0.098], ...
[0 0.447 0.741], ...
[0.466 0.674 0.188], ...
[0.3 0.3 0.3],...
[0.7 0.7 0.7]};

hold on;

for ei = 1:length(eps_cdf)
    
    % پیدا کردن اندیس مربوط به این epsilon در epsilon_vals
    idx = find(abs(epsilon_vals - eps_cdf(ei)) < 1e-6);
    
    if isempty(idx)
        continue;
    end
    
    errors = all_errors{idx};          % خطاهای واقعی شبیه‌سازی
    errors = errors(errors <= 20);     % فقط تا ۲۰ دسی‌بل (برای زیبایی شکل)
    
    % محاسبه Empirical CDF
    [f, x] = ecdf(errors);
    
    plot(x, f, ...
        'LineWidth', 2.0, ...
        'Color', colors_cdf{ei}, ...
        'DisplayName', sprintf('\\epsilon = %.1f', eps_cdf(ei)));
end

% خط عمودی ۱ dBm
xline(1.0, ':k', 'LineWidth', 1.5, 'HandleVisibility', 'off');

% محاسبه درصد خطاهای کمتر از ۱ dBm در ε=1
idx1 = find(abs(epsilon_vals - 1.0) < 1e-6);
errors_eps1 = all_errors{idx1};
pct_below_1 = mean(errors_eps1 <= 1.0) * 100;

text(1.15, 0.12, ...
    sprintf('P(error \\leq 1 dBm) = %.1f%% at \\epsilon=1', pct_below_1), ...
    'FontSize', 9, 'FontName', 'Times New Roman', 'Color', [0.3 0.3 0.3]);

xlabel('DP Power Error |P_{DP} - P_{obs}| (dBm)', ...
    'FontSize', 12, 'FontName', 'Times New Roman');
ylabel('Cumulative Distribution Function', ...
    'FontSize', 12, 'FontName', 'Times New Roman');
title('Empirical CDF of DP Power Perturbation Error', ...
    'FontSize', 12, 'FontName', 'Times New Roman', 'FontWeight', 'bold');

legend('Location', 'southeast', 'FontSize', 9, 'FontName', 'Times New Roman');
grid on; box on;
xlim([0 15]);
ylim([0 1]);

set(gca, 'FontName', 'Times New Roman', 'FontSize', 11);

print('-dpng', '-r300', 'Fig1_CDF_PowerError_Empirical');
fprintf('Figure 1 saved.\n');

%% ============================================================
%  FIGURE 2:
%  MAE vs Privacy Budget epsilon
%% ============================================================


figure( ...
'Units','inches', ...
'Position',[0.5 6 5.2 4.0], ...
'Name','MAE vs epsilon');


semilogy( ...
epsilon_vals, ...
MAE_theoretical, ...
'--k', ...
'LineWidth',2.0, ...
'DisplayName', ...
'Theoretical: MAE = \Delta_f/\epsilon');


hold on;


semilogy( ...
epsilon_vals, ...
MAE_simulated, ...
'-o', ...
'LineWidth',2.0, ...
'Color',[0.850 0.325 0.098], ...
'MarkerFaceColor',[0.850 0.325 0.098], ...
'MarkerSize',8, ...
'DisplayName','Simulation (Laplace)');


yline( ...
1.0, ...
':b', ...
'LineWidth',1.5, ...
'DisplayName','MAE = 1 dBm threshold');


plot( ...
1.0, ...
MAE_simulated(idx1), ...
'bs', ...
'MarkerSize',11, ...
'LineWidth',2, ...
'DisplayName', ...
sprintf( ...
'\\epsilon=1: MAE=%.3f dBm', ...
MAE_simulated(idx1)));


xlabel( ...
'Privacy Budget \epsilon', ...
'FontSize',12, ...
'FontName','Times New Roman');


ylabel( ...
'Mean Absolute Error (dBm)', ...
'FontSize',12, ...
'FontName','Times New Roman');


title( ...
'MAE vs. Privacy Budget \epsilon', ...
'FontSize',12, ...
'FontName','Times New Roman', ...
'FontWeight','bold');


legend( ...
'Location','northeast', ...
'FontSize',9, ...
'FontName','Times New Roman');


grid on;

box on;


xlim([0 10.5]);


set( ...
gca, ...
'FontName','Times New Roman', ...
'FontSize',11, ...
'XTick',epsilon_vals);


print( ...
'-dpng', ...
'-r300', ...
'Fig2_MAE_vs_epsilon');


fprintf('Figure 2 saved.\n');



%% ============================================================
%  FIGURE 3:
%  Spectrum Efficiency eta vs epsilon
%% ============================================================


figure( ...
'Units','inches', ...
'Position',[6.0 6 5.2 4.0], ...
'Name','eta vs epsilon');


plot( ...
epsilon_vals, ...
eta_cal, ...
'-o', ...
'LineWidth',2.0, ...
'Color',[0 0.447 0.741], ...
'MarkerFaceColor',[0 0.447 0.741], ...
'MarkerSize',8, ...
'DisplayName','DP-MTP Protocol');


hold on;


yline( ...
eta_no_noise, ...
'--k', ...
'LineWidth',1.5, ...
'DisplayName', ...
sprintf( ...
'Baseline (\\epsilon=\\infty): %.1f%%', ...
eta_no_noise));


val_eta_eps1 = eta_cal(idx1);


plot( ...
1.0, ...
val_eta_eps1, ...
'rs', ...
'MarkerSize',11, ...
'LineWidth',2, ...
'DisplayName', ...
sprintf( ...
'\\epsilon=1: \\eta=%.1f%%', ...
val_eta_eps1));


yline( ...
val_eta_eps1, ...
':r', ...
'LineWidth',1.2, ...
'HandleVisibility','off');


text( ...
7.5, ...
val_eta_eps1 + 1.2, ...
sprintf('%.1f%%',val_eta_eps1), ...
'Color','r', ...
'FontSize',10, ...
'FontName','Times New Roman');


xlabel( ...
'Privacy Budget \epsilon', ...
'FontSize',12, ...
'FontName','Times New Roman');


ylabel( ...
'Spectrum Utilization Efficiency \eta (%)', ...
'FontSize',12, ...
'FontName','Times New Roman');


title( ...
'Spectrum Efficiency vs. Privacy Budget \epsilon', ...
'FontSize',12, ...
'FontName','Times New Roman', ...
'FontWeight','bold');


legend( ...
'Location','southeast', ...
'FontSize',9, ...
'FontName','Times New Roman');


grid on;

box on;


xlim([0 10.5]);

ylim([60 115]);


set( ...
gca, ...
'FontName','Times New Roman', ...
'FontSize',11, ...
'XTick',epsilon_vals);


print( ...
'-dpng', ...
'-r300', ...
'Fig3_Eta_vs_epsilon');


fprintf('Figure 3 saved.\n');



%% ============================================================
%  FIGURE 4:
%  Heatmap — SU Query Density & epsilon_dynamic
%% ============================================================


figure( ...
'Units','inches', ...
'Position',[0.5 0.5 11.0 4.0], ...
'Name','Density Heatmap');


rng(42);


grid_n = 5;


density = zeros(grid_n,grid_n);



for r = 1:grid_n

    for c = 1:grid_n


        d1 = sqrt((r-2)^2 + (c-2)^2);

        d2 = sqrt((r-4)^2 + (c-4)^2);


        density(r,c) = ...
        0.8*exp(-d1/1.2) + ...
        0.6*exp(-d2/1.2) + ...
        0.05*rand();


    end

end



density = density / max(density(:));


eps_dynamic = ...
epsilon_base * ...
(1 + alpha_adapt * ...
exp(-beta_adapt*density));



subplot(1,2,1);


imagesc(density);


colormap(gca,hot);


cb1 = colorbar;


cb1.Label.String = ...
'Normalized Query Density \rho';


cb1.Label.FontSize = 10;

cb1.Label.FontName = ...
'Times New Roman';


axis square;

axis xy;


xlabel( ...
'Grid Column', ...
'FontSize',11, ...
'FontName','Times New Roman');


ylabel( ...
'Grid Row', ...
'FontSize',11, ...
'FontName','Times New Roman');


title( ...
'(a) SU Query Density \rho', ...
'FontSize',11, ...
'FontName','Times New Roman', ...
'FontWeight','bold');


set( ...
gca, ...
'FontName','Times New Roman', ...
'FontSize',10, ...
'XTick',1:grid_n, ...
'YTick',1:grid_n);



for r = 1:grid_n

    for c = 1:grid_n


        text( ...
        c, ...
        r, ...
        sprintf('%.2f',density(r,c)), ...
        'HorizontalAlignment','center', ...
        'FontSize',7.5, ...
        'Color','w', ...
        'FontName','Times New Roman', ...
        'FontWeight','bold');


    end

end



subplot(1,2,2);


imagesc(eps_dynamic);


colormap(gca,parula);


cb2 = colorbar;


cb2.Label.String = ...
'\epsilon_{dynamic}';


cb2.Label.FontSize = 10;

cb2.Label.FontName = ...
'Times New Roman';


axis square;

axis xy;


xlabel( ...
'Grid Column', ...
'FontSize',11, ...
'FontName','Times New Roman');


ylabel( ...
'Grid Row', ...
'FontSize',11, ...
'FontName','Times New Roman');


title( ...
'(b) Adaptive \epsilon_{dynamic} = \epsilon_{base}(1+0.5e^{-2\rho})', ...
'FontSize',11, ...
'FontName','Times New Roman', ...
'FontWeight','bold');


set( ...
gca, ...
'FontName','Times New Roman', ...
'FontSize',10, ...
'XTick',1:grid_n, ...
'YTick',1:grid_n);



for r = 1:grid_n

    for c = 1:grid_n


        text( ...
        c, ...
        r, ...
        sprintf('%.2f',eps_dynamic(r,c)), ...
        'HorizontalAlignment','center', ...
        'FontSize',7.5, ...
        'Color','k', ...
        'FontName','Times New Roman', ...
        'FontWeight','bold');


    end

end



sgtitle( ...
'SU Density and Adaptive \epsilon_{dynamic} (5\times5 Grid)', ...
'FontSize',12, ...
'FontName','Times New Roman', ...
'FontWeight','bold');


print( ...
'-dpng', ...
'-r300', ...
'Fig4_Heatmap_Density_Epsilon');


fprintf('Figure 4 saved.\n');


%% ============================================================
%  FIGURE 5:
%  Adaptive DP — MAE across Density Scenarios
%% ============================================================


figure( ...
'Units','inches', ...
'Position',[6.0 0.5 5.2 4.0], ...
'Name','Adaptive MAE Scenarios');


num_regions = 25;


rho_uniform = ones(1,num_regions) * 0.5;


rho_clustered = [ ...
ones(1,5)*0.9, ...
ones(1,5)*0.8, ...
ones(1,5)*0.7, ...
ones(1,5)*0.1, ...
ones(1,5)*0.1];


rho_sparse = [ ...
ones(1,13)*0.6, ...
zeros(1,12)];


scenarios = { ...
rho_uniform, ...
rho_clustered, ...
rho_sparse};


eps_dyn_fn = @(rho) ...
epsilon_base * ...
(1 + alpha_adapt * exp(-beta_adapt*rho));


eps_fixed = epsilon_base;


MAE_fixed_all = zeros(1,3);

MAE_adaptive_all = zeros(1,3);

eta_adaptive_all = zeros(1,3);



for sc = 1:3


    rho_sc = scenarios{sc};


    eps_dyn_sc = eps_dyn_fn(rho_sc);


    MAE_fixed_all(sc) = Delta_f / eps_fixed;


    MAE_adaptive_all(sc) = ...
    mean(Delta_f ./ eps_dyn_sc);



    eta_per_region = zeros(1,num_regions);



    for reg = 1:num_regions


        [~, eta_reg, ~, ~, ~] = ...
        run_mc( ...
        eps_dyn_sc(reg), ...
        Delta_f, ...
        N_SU, ...
        N_PU, ...
        P_max, ...
        area_size, ...
        100, ...
        gamma, ...
        sigma_m);


        eta_per_region(reg) = eta_reg;

    end


    eta_adaptive_all(sc) = ...
    mean(eta_per_region) * scale_eta * 100;


end



bar_data = [ ...
MAE_fixed_all;
MAE_adaptive_all]';


b_hdl = bar(1:3,bar_data,0.65);


b_hdl(1).FaceColor = [0.7 0.7 0.7];

b_hdl(2).FaceColor = [0 0.447 0.741];


hold on;


eta_fixed_eps1 = eta_cal(idx1);


for sc = 1:3


    delta_eta = ...
    eta_adaptive_all(sc) - eta_fixed_eps1;


    text( ...
    sc, ...
    max(bar_data(sc,:))*1.08, ...
    sprintf('+%.1f%% \\eta',delta_eta), ...
    'HorizontalAlignment','center', ...
    'FontSize',9, ...
    'Color','k', ...
    'FontName','Times New Roman');


end


xlabel( ...
'Deployment Scenario', ...
'FontSize',12, ...
'FontName','Times New Roman');


ylabel( ...
'Mean Absolute Error (dBm)', ...
'FontSize',12, ...
'FontName','Times New Roman');


title( ...
'Adaptive DP: MAE Across Density Scenarios', ...
'FontSize',12, ...
'FontName','Times New Roman', ...
'FontWeight','bold');


set( ...
gca, ...
'XTickLabel', ...
{'Uniform','Clustered','Sparse'}, ...
'FontName','Times New Roman', ...
'FontSize',10);


legend( ...
{'Fixed \epsilon=1.0', ...
'Adaptive \epsilon_{dynamic}'}, ...
'Location','northeast', ...
'FontSize',9, ...
'FontName','Times New Roman');

ylim([0, max(bar_data(:))*1.35]);
grid on;

box on;


print( ...
'-dpng', ...
'-r300', ...
'Fig5_Adaptive_MAE_Scenarios');


fprintf('Figure 5 saved.\n');


%% ============================================================
%  FIGURE 6:
%  RMSE Attack vs epsilon
%% ============================================================


figure( ...
'Units','inches', ...
'Position',[11.5 6 5.2 4.0], ...
'Name','RMSE vs epsilon');


semilogy( ...
epsilon_vals, ...
RMSE_DPMTP_m, ...
'-o', ...
'LineWidth',2.5, ...
'Color',[0 0.447 0.741], ...
'MarkerFaceColor',[0 0.447 0.741], ...
'MarkerSize',8, ...
'DisplayName','DP-MTP (Proposed)');


hold on;


semilogy( ...
epsilon_vals, ...
RMSE_LO, ...
'-s', ...
'LineWidth',1.8, ...
'Color',[0.850 0.325 0.098], ...
'MarkerFaceColor',[0.850 0.325 0.098], ...
'MarkerSize',7, ...
'DisplayName','Location Obfuscation (LO)');


semilogy( ...
epsilon_vals, ...
RMSE_KAnon, ...
'-^', ...
'LineWidth',1.8, ...
'Color',[0.466 0.674 0.188], ...
'MarkerFaceColor',[0.466 0.674 0.188], ...
'MarkerSize',7, ...
'DisplayName','K-Anonymity (k=3)');


semilogy( ...
epsilon_vals, ...
RMSE_CR, ...
'-d', ...
'LineWidth',1.8, ...
'Color',[0.494 0.184 0.556], ...
'MarkerFaceColor',[0.494 0.184 0.556], ...
'MarkerSize',7, ...
'DisplayName','Cloaking Regions (CR)');


semilogy( ...
epsilon_vals, ...
RMSE_base, ...
'--k', ...
'LineWidth',1.5, ...
'DisplayName','No Protection');


yline( ...
50, ...
':b', ...
'LineWidth',1.2, ...
'DisplayName','50m threshold');


yline( ...
5, ...
':r', ...
'LineWidth',1.2, ...
'DisplayName','5m threshold');


xlabel( ...
'Privacy Budget \epsilon', ...
'FontSize',12, ...
'FontName','Times New Roman');


ylabel( ...
'Adversary RMSE (m)', ...
'FontSize',12, ...
'FontName','Times New Roman');


title( ...
'Attack RMSE vs. \epsilon (Baseline Comparison)', ...
'FontSize',12, ...
'FontName','Times New Roman', ...
'FontWeight','bold');


legend( ...
'Location','northeast', ...
'FontSize',8, ...
'FontName','Times New Roman');


grid on;

box on;


xlim([0 10.5]);


set( ...
gca, ...
'FontName','Times New Roman', ...
'FontSize',11, ...
'XTick',epsilon_vals);


print( ...
'-dpng', ...
'-r300', ...
'Fig6_RMSE_vs_epsilon');


fprintf('Figure 6 saved.\n');





%% ============================================================
%  FIGURE 7:
%  Bar Chart — Multi-Metric Comparison
%% ============================================================


figure( ...
'Units','inches', ...
'Position',[11.5 0.5 6.0 4.5], ...
'Name','Baseline Bar Comparison');


mae_dpmtp = MAE_simulated(idx1);


MAE_norm = [ ...
mae_base/mae_dpmtp_total, ...
mae_lo/mae_dpmtp_total, ...
mae_kanon/mae_dpmtp_total, ...
mae_cr/mae_dpmtp_total, ...
1.0];


rmse_dpmtp_ref = RMSE_DPMTP_m(idx1);


RMSE_norm = [ ...
RMSE_base_val/rmse_dpmtp_ref, ...
rmse_lo_m/rmse_dpmtp_ref, ...
rmse_kanon_m/rmse_dpmtp_ref, ...
rmse_cr_m/rmse_dpmtp_ref, ...
1.0];


eta_norm = zeros(1,5);


eta_norm(1) = 1.0;

eta_norm(2) = eta_lo / eta_no_noise;

eta_norm(3) = eta_kanon / eta_no_noise;

eta_norm(4) = eta_cr / eta_no_noise;

eta_norm(5) = eta_cal(idx1) / eta_no_noise;



comp_cost = [ ...
1, ...
N_SU, ...
N_SU^2, ...
N_SU, ...
N_SU];


OH_norm = comp_cost / max(comp_cost);



bar_matrix = [ ...
MAE_norm;
RMSE_norm;
eta_norm;
OH_norm]';


b2 = bar(1:5,bar_matrix,0.75);


xlabel( ...
'Privacy Mechanism', ...
'FontSize',12, ...
'FontName','Times New Roman');


ylabel( ...
'Normalized Performance', ...
'FontSize',12, ...
'FontName','Times New Roman');


title( ...
'Multi-Metric Comparison with Baseline Mechanisms', ...
'FontSize',12, ...
'FontName','Times New Roman', ...
'FontWeight','bold');


legend( ...
{'MAE (noise level)', ...
'RMSE_{attack} (privacy)', ...
'Spectrum Eff. \eta', ...
'Overhead'}, ...
'Location','northeast', ...
'FontSize',8, ...
'FontName','Times New Roman');


mechanisms = { ...
'No Protection', ...
'LO (\sigma=20m)', ...
'K-Anon (k=3)', ...
'Cloak (100m)', ...
'DP-MTP (\epsilon=1)'};


set( ...
gca, ...
'XTickLabel',mechanisms, ...
'FontName','Times New Roman', ...
'FontSize',8.5, ...
'XTickLabelRotation',15);


grid on;

box on;


ylim([0 max(bar_matrix(:))*1.15]);


annotation( ...
'rectangle', ...
[0.73 0.12 0.12 0.78], ...
'Color',[0 0.447 0.741], ...
'LineWidth',2, ...
'LineStyle','--');


print( ...
'-dpng', ...
'-r300', ...
'Fig7_Baseline_Comparison_Bar');


fprintf('Figure 7 saved.\n');





%% ============================================================
%  SUMMARY
%% ============================================================


fprintf('\n');

fprintf('========================================\n');

fprintf('All 7 figures generated successfully.\n');

fprintf('----------------------------------------\n');

fprintf('Fig 1: CDF of Power Error\n');

fprintf('Fig 2: MAE vs epsilon\n');

fprintf('Fig 3: eta vs epsilon\n');

fprintf('Fig 4: Heatmap Density & eps_dyn\n');

fprintf('Fig 5: Adaptive MAE Scenarios\n');

fprintf('Fig 6: RMSE Attack vs epsilon\n');

fprintf('Fig 7: Multi-Metric Bar Chart\n');

fprintf('========================================\n\n');



%% ============================================================
%  TABLE 1:
%  Trade-off Analysis
%% ============================================================


fprintf('--- Table 1: Trade-off Analysis ---\n');


fprintf( ...
'%-10s | %-20s | %-18s | %-14s\n', ...
'epsilon', ...
'Location RMSE (m)', ...
'Throughput Loss (%)', ...
'Power Error (dBm)');


fprintf('%s\n',repmat('-',1,72));


for ei = 1:length(epsilon_vals)


    throughput_loss = 100 - eta_cal(ei);

    power_err = MAE_simulated(ei);

    loc_rmse = RMSE_DPMTP_m(ei);


    fprintf( ...
    '%-10.1f | %-20.2f | %-18.2f | %-14.4f\n', ...
    epsilon_vals(ei), ...
    loc_rmse, ...
    throughput_loss, ...
    power_err);


end


fprintf('\n');



