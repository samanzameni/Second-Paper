%% ============================================================


fprintf('--- Table 2: Comparison with Non-DP Defenses ---\n');
fprintf('%-20s | %-16s | %-18s | %-18s | %-20s\n', ...
        'Mechanism', 'Loc. RMSE (m)', 'Total MAE (dBm)', 'Throughput Loss (%)', 'Privacy Guarantee');
fprintf('%s\n', repmat('-', 1, 106));

mechs_t2 = {'No Protection', 'LO (sigma=20m)', 'K-Anon (k=3)', 'Cloaking (100m)', 'DP-MTP (eps=1)'};
rmse_t2 = [RMSE_base_val, rmse_lo_m, rmse_kanon_m, rmse_cr_m, RMSE_DPMTP_m(idx1)];

mae_t2 = [mae_base, mae_lo, mae_kanon, mae_cr, mae_dpmtp_total];

thr_loss_t2 = [100-eta_no_noise, 100-eta_lo, 100-eta_kanon, 100-eta_cr, 100-eta_cal(idx1)];
priv_t2 = {'None', 'Heuristic', 'Heuristic', 'Heuristic', 'Laplace-based DP'};

for i = 1:5
    fprintf('%-20s | %-16.2f | %-18.4f | %-18.2f | %-20s\n', ...
            mechs_t2{i}, rmse_t2(i), mae_t2(i), thr_loss_t2(i), priv_t2{i});
end
fprintf('\n');




